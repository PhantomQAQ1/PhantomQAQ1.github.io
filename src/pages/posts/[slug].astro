---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import PostMeta from '../../components/blog/PostMeta.astro';
import TableOfContents from '../../components/blog/TableOfContents.astro';
import TagPill from '../../components/ui/TagPill.astro';
import StarIcon from '../../components/ui/StarIcon.astro';
import HandDivider from '../../components/ui/HandDivider.astro';
import { getPosts, getHeadings, readingTime, formatDate, isoDate, tagHref } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      prev: posts[i + 1] ?? null,
      next: posts[i - 1] ?? null,
    },
  }));
}) satisfies GetStaticPaths;

const { post, prev, next } = Astro.props;
const { Content } = await render(post);

const headings = getHeadings(post);
const minutes = readingTime(post);
const date = formatDate(post.data.pubDate);
const updated = post.data.updatedDate ? formatDate(post.data.updatedDate) : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: isoDate(post.data.pubDate),
  dateModified: isoDate(post.data.updatedDate ?? post.data.pubDate),
  author: { '@type': 'Person', name: 'Phanatomcat' },
  keywords: post.data.tags.join(', '),
  inLanguage: 'zh-CN',
};
---

<PageLayout
  title={`${post.data.title} · Phanatomcat`}
  description={post.data.description}
  type="article"
  progress
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />

  <div class="relative mx-auto max-w-[1120px] px-5 pt-14 sm:px-8 lg:px-10">
    <article class="mx-auto max-w-[40rem]">
      <!-- 文章头 -->
      <header class="relative">
        <StarIcon size={13} class="anim-float absolute -top-2 right-0 text-sakura/70" />

        <a
          href="/posts"
          class="inline-flex items-center gap-1.5 text-[0.75rem] text-ink-mute transition hover:text-ink"
        >
          <span class="font-latin tracking-[0.16em] uppercase">Archive</span>
          <span>·</span>
          <span>{post.data.category}</span>
        </a>

        <h1
          class="mt-4 font-display text-[clamp(1.875rem,3.6vw,2.625rem)] leading-[1.35] tracking-[-0.005em] text-ink"
        >
          {post.data.title}
        </h1>

        <p class="mt-4 text-[0.9375rem] leading-[1.9] text-ink-soft">{post.data.description}</p>

        <div class="mt-6 flex flex-wrap items-center justify-between gap-4">
          <PostMeta date={date} readingTime={minutes} />
          <div class="flex flex-wrap gap-1.5">
            {post.data.tags.map((tag) => <TagPill name={tag} />)}
          </div>
        </div>

        {updated && <p class="mt-3 text-[0.75rem] text-ink-mute">最后修改于 {updated}</p>}
      </header>

      <HandDivider variant="spiral" class="mt-10 mb-12" />

      <!-- 正文：唯一的干净区域 -->
      <div class="prose-hand" data-pagefind-body data-pagefind-filter={`category:${post.data.category}`}>
        <Content />
      </div>

      <HandDivider variant="spiral" class="mt-14 mb-10" />

      <!-- 文章尾 -->
      <footer>
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap gap-1.5">
            {post.data.tags.map((tag) => <TagPill name={tag} size="md" />)}
          </div>
          <a
            href="/tags"
            class="text-[0.8125rem] text-ink-mute transition hover:text-ink"
          >
            浏览全部标签 →
          </a>
        </div>

        <div class="mt-10 flex items-center gap-4 text-[0.75rem] text-ink-mute">
          <span class="h-px flex-1 bg-line"></span>
          <span class="font-display">— 完 —</span>
          <span class="h-px flex-1 bg-line"></span>
        </div>

        <!-- 上一篇 / 下一篇 -->
        <nav class="mt-10 grid gap-4 sm:grid-cols-2" aria-label="邻近文章">
          {prev ? (
            <a href={`/posts/${prev.id}`} class="card-hand group block p-5">
              <p class="kicker flex items-center gap-1.5">
                <span class="transition group-hover:-translate-x-0.5">←</span> 上一篇
              </p>
              <p class="mt-2 font-display text-[1rem] leading-snug text-ink">{prev.data.title}</p>
            </a>
          ) : (
            <span class="hidden sm:block"></span>
          )}

          {next && (
            <a href={`/posts/${next.id}`} class="card-hand group block p-5 sm:text-right">
              <p class="kicker flex items-center gap-1.5 sm:justify-end">
                下一篇 <span class="transition group-hover:translate-x-0.5">→</span>
              </p>
              <p class="mt-2 font-display text-[1rem] leading-snug text-ink">{next.data.title}</p>
            </a>
          )}
        </nav>

        <div class="mt-10 text-center">
          <a
            href="/posts"
            class="text-[0.8125rem] text-ink-soft underline decoration-sakura-ink/60 decoration-wavy decoration-[1.5px] underline-offset-[6px] transition hover:text-ink"
          >
            回到全部文章
          </a>
        </div>
      </footer>
    </article>

    <div class="absolute inset-y-0 left-[calc(50%+21rem)] hidden w-[11rem] xl:block">
      <div class="sticky top-28">
        <TableOfContents headings={headings} />
      </div>
    </div>
  </div>
</PageLayout>
