---
import PageLayout from '../../layouts/PageLayout.astro';
import ArchiveList from '../../components/blog/ArchiveList.astro';
import HandDivider from '../../components/ui/HandDivider.astro';
import StarIcon from '../../components/ui/StarIcon.astro';
import { getPosts } from '../../lib/posts';

const PAGE_SIZE = 9;
const all = await getPosts();
const totalPages = Math.max(1, Math.ceil(all.length / PAGE_SIZE));
const posts = all.slice(0, PAGE_SIZE);
---

<PageLayout title="全部文章 · Phanatomcat" description="按时间倒序排列的全部文章：小说、随笔、日志。">
  <section class="mx-auto max-w-[1120px] px-5 pt-14 sm:px-8 lg:px-10">
    <p class="kicker flex items-center gap-2">
      <StarIcon size={9} class="text-sakura-ink" />
      Archive
    </p>
    <h1 class="mt-4 font-display text-[clamp(2.25rem,4.6vw,3.25rem)] leading-tight text-ink">
      全部文章
    </h1>
    <p class="mt-4 max-w-[34rem] text-[0.9375rem] leading-[1.9] text-ink-soft">
      共 {all.length} 篇。按时间倒序，不分类别——想到哪篇，就在哪篇旁边停一下。
    </p>

    <div class="mt-6 flex items-center gap-3 text-[0.75rem] text-ink-mute">
      <span class="h-px w-8 bg-line"></span>
      <span>最近更新 <time class="font-latin">{all[0] ? new Date(all[0].data.pubDate).toISOString().slice(0, 10) : '—'}</time></span>
    </div>
  </section>

  <HandDivider variant="wave" class="mx-auto mt-12 max-w-[1120px] px-5 opacity-70 sm:px-8 lg:px-10" />

  <section class="mx-auto max-w-[1120px] px-5 pt-12 sm:px-8 lg:px-10">
    <ArchiveList posts={posts} page={1} totalPages={totalPages} />
  </section>
</PageLayout>
