---
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import PostCard from '../../components/content/PostCard.astro';
import TagCloud from '../../components/blog/TagCloud.astro';
import HandDivider from '../../components/ui/HandDivider.astro';
import StarIcon from '../../components/ui/StarIcon.astro';
import { getPosts, getTags, toCard, type Post } from '../../lib/posts';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  const tags = await getTags(posts);

  return tags.map((tag) => ({
    params: { tag: tag.name },
    props: {
      name: tag.name,
      posts: posts.filter((post) => post.data.tags.includes(tag.name)),
      others: tags.filter((t) => t.name !== tag.name),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  name: string;
  posts: Post[];
  others: { name: string; count: number; latest: number }[];
}

const { name, posts, others } = Astro.props;
const cards = posts.map(toCard);
---

<PageLayout
  title={`#${name} · Phanatomcat`}
  description={`标签「${name}」下的${posts.length}篇文章。`}
>
  <section class="mx-auto max-w-[1120px] px-5 pt-14 sm:px-8 lg:px-10">
    <a
      href="/tags"
      class="inline-flex items-center gap-1.5 text-[0.75rem] text-ink-mute transition hover:text-ink"
    >
      <span class="transition hover:-translate-x-0.5">←</span> 全部标签
    </a>

    <div class="mt-5 flex flex-wrap items-end gap-x-4 gap-y-2">
      <h1 class="font-display text-[clamp(2rem,4.4vw,3rem)] leading-tight text-ink">
        <span class="text-sakura-ink">#</span>{name}
      </h1>
      <p class="pb-2 font-latin text-[0.8125rem] tracking-[0.12em] text-ink-mute uppercase">
        {posts.length} posts
      </p>
      <StarIcon size={12} class="mb-3 text-sakura/70" />
    </div>
  </section>

  <HandDivider variant="wave" class="mx-auto mt-10 max-w-[1120px] px-5 opacity-70 sm:px-8 lg:px-10" />

  <section class="mx-auto max-w-[1120px] px-5 pt-12 sm:px-8 lg:px-10">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <section class="mx-auto max-w-[1120px] px-5 pt-16 sm:px-8 lg:px-10">
    <p class="kicker">Next</p>
    <h2 class="mt-3 font-display text-[1.375rem] text-ink">换个标签看看</h2>
    <div class="mt-5">
      <TagCloud tags={others} limit={14} />
    </div>
  </section>
</PageLayout>
