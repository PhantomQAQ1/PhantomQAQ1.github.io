---
/**
 * 账号内容展示区。
 * 图片放在 src/assets/game-accounts/<slug>/ 下，构建时自动收集，无需改代码。
 * 没放图时显示虚线空位，方便之后补素材。
 */
import { getGameShots, gameShotsFolder } from '../../lib/gameShots';

interface Props {
  slug: string;
  name: string;
  class?: string;
}

const { slug, name, class: cls = '' } = Astro.props;

const shots = getGameShots(slug, name);
const folder = gameShotsFolder(slug);
---

<section class:list={['relative', cls]} aria-label="账号内容">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <p class="kicker">Account · 账号内容</p>
    {
      shots.length > 0 ? (
        <p class="text-[0.75rem] text-ink-mute">{shots.length} 张截图 · 点击看原图</p>
      ) : (
        <p class="text-[0.75rem] text-ink-mute">截图待补</p>
      )
    }
  </div>

  {
    shots.length > 0 ? (
      <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {shots.map((shot) => (
          <figure class="group relative overflow-hidden rounded-[16px] border-[1.5px] border-line bg-surface shadow-[2px_3px_0_rgba(43,42,51,0.06),0_16px_36px_-24px_rgba(108,92,231,0.45)]">
            <a
              href={shot.src}
              target="_blank"
              rel="noopener noreferrer"
              class="block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-night/45"
              aria-label={`${shot.alt}（在新标签页打开原图）`}
            >
              <img
                src={shot.src}
                width={shot.width}
                height={shot.height}
                alt={shot.alt}
                loading="lazy"
                decoding="async"
                class="block h-auto w-full transition duration-300 group-hover:scale-[1.015]"
              />
            </a>
            <figcaption class="flex items-center gap-2 border-t border-line/80 px-3.5 py-2 text-[0.75rem] text-ink-soft">
              <span class="h-1 w-1 rounded-full bg-sakura-ink/60" aria-hidden="true" />
              {shot.caption}
            </figcaption>
          </figure>
        ))}
      </div>
    ) : (
      <>
        <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {[1, 2, 3].map((slot) => (
            <div
              class="flex aspect-[4/3] flex-col items-center justify-center gap-1 rounded-[16px] border-[1.5px] border-dashed border-line bg-sunken/50"
              aria-hidden="true"
            >
              <span class="font-latin text-[0.625rem] tracking-[0.2em] text-ink-mute uppercase">
                Slot {String(slot).padStart(2, '0')}
              </span>
              <span class="text-[0.75rem] text-ink-mute">待补图</span>
            </div>
          ))}
        </div>
        <p class="mt-3 text-[0.75rem] leading-relaxed text-ink-mute">
          把截图放进
          <code
            class="mx-1 rounded-[5px] border border-line bg-sunken px-1.5 py-0.5 text-[0.6875rem] text-ink-soft"
          >{folder}</code>
          重新构建后会自动出现在这里，文件名即说明。
        </p>
      </>
    )
  }
</section>
