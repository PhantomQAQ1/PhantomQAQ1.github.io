---
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<div class:list={['flex flex-col items-center justify-center py-14 text-center', cls]} data-empty hidden>
  <svg
    width="120"
    height="120"
    viewBox="0 0 120 120"
    fill="none"
    class="text-ink-mute"
    aria-hidden="true"
  >
    <!-- 小幽灵 -->
    <path
      d="M38 74V52a22 22 0 0 1 44 0v22l-7-5-7 5-7-5-7 5-7-5-9 5Z"
      fill="currentColor"
      fill-opacity="0.07"
      stroke="currentColor"
      stroke-opacity="0.45"
      stroke-width="1.6"
      stroke-linejoin="round"></path>
    <circle cx="53" cy="55" r="2.4" fill="currentColor" fill-opacity="0.55"></circle>
    <circle cx="67" cy="55" r="2.4" fill="currentColor" fill-opacity="0.55"></circle>
    <path
      d="M56 63c1.6 1.6 6.4 1.6 8 0"
      stroke="currentColor"
      stroke-opacity="0.45"
      stroke-width="1.4"
      stroke-linecap="round"></path>

    <!-- 星星 -->
    <path
      d="M26 34l2.2 5.6L34 42l-5.8 2.4L26 50l-2.2-5.6L18 42l5.8-2.4L26 34Z"
      fill="#FFB7C5"
      fill-opacity="0.85"></path>
    <path
      d="M94 30l1.5 3.9 3.9 1.5-3.9 1.5-1.5 3.9-1.5-3.9-3.9-1.5 3.9-1.5L94 30Z"
      fill="#A8E6CF"
      fill-opacity="0.9"></path>
    <path
      d="M92 82l1.2 3 3 1.2-3 1.2-1.2 3-1.2-3-3-1.2 3-1.2L92 82Z"
      fill="#6C5CE7"
      fill-opacity="0.45"></path>
  </svg>

  <p class="mt-5 font-display text-[1.125rem] text-ink">暂无游戏记录</p>
  <p class="mt-2 max-w-[20rem] text-[0.8125rem] leading-relaxed text-ink-mute">
    换一个筛选条件试试，或者点「重置筛选」看看全部游戏。
  </p>
</div>
