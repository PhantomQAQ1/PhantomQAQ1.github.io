---
import GameCover from './GameCover.astro';
import StatusBadge from './StatusBadge.astro';
import StickerTape from '../ui/StickerTape.astro';
import type { Game } from '../../data/games';
import { formatHours } from '../../data/games';

interface Props {
  game: Game;
  class?: string;
}

const { game, class: cls = '' } = Astro.props;
const rating = Math.max(0, Math.min(5, game.rating ?? 0));
const ratingPct = (rating / 5) * 100;
---

<article
  class:list={['card-hand group relative flex h-full flex-col overflow-hidden', cls]}
  data-game
  data-status={game.status}
  data-genre={game.genre}
  data-tags={game.tags.join(' ')}
  data-name={game.name}
>
  <div class="relative" data-pagefind-ignore>
    <GameCover
      slug={game.slug}
      glyph={game.cover.glyph}
      label={game.cover.label ?? game.genre}
      tone={game.cover.tone}
      gradient={game.coverGradient}
    />
    <StickerTape class="-top-2 left-4" rotate={-7} width={62} />
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-display text-[1.125rem] leading-snug text-ink">{game.name}</h3>
      <StatusBadge status={game.status} />
    </div>

    <p class="mt-1.5 flex flex-wrap items-center gap-x-1.5 font-latin text-[0.75rem] text-ink-mute">
      <span>{game.genre}</span>
      <span class="h-1 w-1 rounded-full bg-ink-mute/50"></span>
      <span class="font-body">{game.platforms.join(' / ')}</span>
      {
        game.playtime !== undefined && (
          <>
            <span class="h-1 w-1 rounded-full bg-ink-mute/50" />
            <span class="font-body">{formatHours(game.playtime)} 小时</span>
          </>
        )
      }
      {
        game.profile?.level !== undefined && (
          <>
            <span class="h-1 w-1 rounded-full bg-ink-mute/50" />
            <span class="font-latin">Lv.{game.profile.level}</span>
          </>
        )
      }
    </p>

    <p class="mt-3 line-clamp-2 text-[0.875rem] leading-[1.75] text-ink-soft">{game.shortReview}</p>

    <div class="mt-auto flex items-end justify-between gap-3 pt-4" data-pagefind-ignore>
      <div class="flex flex-wrap gap-1.5">
        {
          game.tags.map((tag) => (
            <span class="rounded-[9px] border-[1.2px] border-line bg-tape/55 px-2 py-0.5 text-[0.6875rem] text-ink-soft dark:bg-tape/45">
              {tag}
            </span>
          ))
        }
      </div>

      {
        game.rating !== undefined ? (
          <p
            class="relative shrink-0 font-latin text-[0.75rem]"
            aria-label={`评分 ${game.rating} 分，满分 5 分`}
          >
            <span aria-hidden="true" class="text-ink-mute/35">★★★★★</span>
            <span
              aria-hidden="true"
              class="absolute inset-y-0 left-0 overflow-hidden whitespace-nowrap text-sakura-ink"
              style={`width:${ratingPct}%`}>★★★★★</span
            >
          </p>
        ) : (
          <p class="shrink-0 text-[0.6875rem] text-ink-mute">未评分</p>
        )
      }
    </div>
  </div>

  <!-- 整卡可点：覆盖式链接，不影响标签与卡片布局 -->
  <a
    href={`/games/${game.slug}/`}
    class="absolute inset-0 z-10 rounded-[inherit] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-night/45 focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
    aria-label={`${game.name}：${game.shortReview}`}
  ></a>
</article>
