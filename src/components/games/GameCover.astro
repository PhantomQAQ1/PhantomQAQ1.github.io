---
import type { CoverTone } from '../../data/games';

interface Props {
  slug: string;
  glyph: string;
  label: string;
  tone?: CoverTone;
  /** 可选：直接给一条 CSS 渐变，覆盖调色方案 */
  gradient?: string;
  class?: string;
}

const { slug, glyph, label, tone, gradient, class: cls = '' } = Astro.props;

// [深, 浅, 强调]：和文章封面同一套「小清新书封」语言
const palettes: Record<CoverTone, [string, string, string]> = {
  sakura: ['#FFC9DA', '#FFF1F5', '#D14E77'],
  mint: ['#C4EDDC', '#F0FBF6', '#2F8268'],
  night: ['#D6CFFF', '#F2EFFF', '#5A48D6'],
  cream: ['#FFDFBA', '#FFF7EA', '#C97B33'],
  lavender: ['#E4DBFF', '#F6F2FF', '#6C5CE7'],
  ash: ['#D9D5DE', '#F4F2F5', '#6E6B7B'],
};

const fallback: CoverTone[] = ['sakura', 'mint', 'night', 'cream', 'lavender'];
let hash = 0;
for (const ch of slug) hash = (hash * 31 + (ch.codePointAt(0) ?? 0)) >>> 0;

const key = tone ?? fallback[hash % fallback.length];
const [deep, light, accent] = palettes[key];
---

<div
  class:list={['game-cover relative overflow-hidden', cls]}
  style={`--cover-deep:${deep}; --cover-light:${light}; --cover-accent:${accent}`}
  aria-hidden="true"
>
  <div
    class:list={['gc-wash absolute inset-0', gradient && 'gc-wash--custom']}
    style={gradient ? `background-image:${gradient}` : undefined}
  ></div>
  <div class="gc-dots absolute inset-0"></div>

  <!-- 左上角像素星：三格十字 -->
  <svg class="gc-pixel absolute top-3.5 right-4" viewBox="0 0 21 21" aria-hidden="true">
    <g fill="currentColor">
      <rect x="8" y="0" width="5" height="5" />
      <rect x="0" y="8" width="5" height="5" />
      <rect x="16" y="8" width="5" height="5" />
      <rect x="8" y="16" width="5" height="5" />
      <rect x="8" y="8" width="5" height="5" />
    </g>
  </svg>

  <!-- 手绘细线框 -->
  <span class="gc-frame absolute inset-2.5"></span>

  <span class="gc-badge absolute inset-0 flex items-center justify-center"
    ><span class="gc-glyph">{glyph}</span></span
  >

  <span class="gc-label absolute bottom-3 left-4">{label}</span>

  <!-- 右下角贝壳螺旋，和文章封面同一记号 -->
  <svg class="gc-spiral absolute -right-5 -bottom-6 h-[62%] w-auto" viewBox="0 0 64 64" fill="none">
    <path
      d="M41 23a9 9 0 1 0-9 9 15 15 0 1 0 15-15 22 22 0 1 0 22 22"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"></path>
  </svg>
</div>

<style>
  .game-cover {
    aspect-ratio: 4 / 3;
    background: var(--surface-sunken);
  }

  .gc-wash {
    background: linear-gradient(
      142deg,
      var(--cover-deep) 0%,
      var(--cover-light) 58%,
      var(--cover-light) 100%
    );
  }

  .gc-dots {
    background-image: radial-gradient(circle, rgb(255 255 255 / 0.85) 1px, transparent 1px);
    background-size: 14px 14px;
    opacity: 0.45;
    mask-image: linear-gradient(125deg, #000 0%, transparent 58%);
  }

  .gc-pixel {
    width: 21px;
    color: color-mix(in srgb, var(--cover-accent) 42%, #ffffff);
    opacity: 0.75;
  }

  .gc-frame {
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 12px 18px 10px 16px;
    pointer-events: none;
  }

  .gc-glyph {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.72);
    border: 1.5px solid rgb(255 255 255 / 0.85);
    box-shadow:
      0 8px 18px -10px color-mix(in srgb, var(--cover-accent) 50%, transparent),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
    font-size: 1.9rem;
    line-height: 1;
    color: color-mix(in srgb, var(--cover-accent) 70%, #2b2a33);
    filter: saturate(0.92);
  }

  .gc-label {
    font-family: var(--font-latin);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cover-accent) 86%, #2b2a33);
    background: rgb(255 255 255 / 0.55);
    border-radius: 6px;
    padding: 0.1rem 0.4rem;
  }

  .gc-spiral {
    color: rgb(255 255 255 / 0.5);
  }

  /* 深色：压暗封面，只留一点颜色记忆 */
  :global(.dark) .gc-wash {
    opacity: 0.4;
  }

  :global(.dark) .gc-dots {
    opacity: 0.14;
  }

  :global(.dark) .gc-glyph {
    background: rgb(255 255 255 / 0.09);
    border-color: rgb(255 255 255 / 0.14);
    color: rgb(255 255 255 / 0.66);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.08);
  }

  :global(.dark) .gc-label {
    color: rgb(255 255 255 / 0.72);
    background: rgb(255 255 255 / 0.1);
  }

  :global(.dark) .gc-pixel {
    color: rgb(255 255 255 / 0.28);
  }

  :global(.dark) .gc-spiral {
    color: rgb(255 255 255 / 0.14);
  }

  :global(.dark) .gc-frame {
    border-color: rgb(255 255 255 / 0.14);
  }
</style>
