---
interface Props {
  slug: string;
  label: string;
  tone?: 'sakura' | 'mint' | 'night';
  ratio?: '16/10' | '1/1' | '4/3';
  class?: string;
}

const { slug, label, tone, ratio = '16/10', class: cls = '' } = Astro.props;

// [深, 浅, 强调色]：封面只用三色，保持「小清新书封」的干净
const palettes: [string, string, string][] = [
  ['#FFC9DA', '#FFF1F5', '#D14E77'],
  ['#C4EDDC', '#F0FBF6', '#2F8268'],
  ['#D6CFFF', '#F2EFFF', '#5A48D6'],
  ['#FFDFBA', '#FFF7EA', '#C97B33'],
  ['#FFCBDD', '#E7E0FF', '#6C5CE7'],
];

let hash = 0;
for (const ch of slug) hash = (hash * 31 + (ch.codePointAt(0) ?? 0)) >>> 0;

const toneIndex = tone === 'sakura' ? 0 : tone === 'mint' ? 1 : tone === 'night' ? 2 : null;
const [c1, c2, accent] = palettes[toneIndex ?? hash % palettes.length];
---

<div
  class:list={['cover-art relative overflow-hidden bg-sunken', cls]}
  style={`aspect-ratio:${ratio}; --cover-deep:${c1}; --cover-light:${c2}; --cover-accent:${accent}`}
  aria-hidden="true"
>
  <div class="cover-wash absolute inset-0"></div>

  <!-- 手绘点阵 -->
  <div class="cover-dots absolute inset-0"></div>

  <!-- 同心螺旋：取自海螺壳 -->
  <svg
    class="cover-spiral absolute -right-6 -bottom-8 h-[76%] w-auto text-white/55"
    viewBox="0 0 64 64"
    fill="none"
  >
    <path
      d="M41 23a9 9 0 1 0-9 9 15 15 0 1 0 15-15 22 22 0 1 0 22 22"
      stroke="currentColor"
      stroke-width="1.4"
      stroke-linecap="round"></path>
  </svg>

  <!-- 分类首字：轻小说封面的「题字」位置 -->
  <span class="cover-glyph font-display absolute top-1/2 left-5 -translate-y-1/2"
    >{label.slice(0, 1)}</span
  >

  <span class="cover-label absolute bottom-3 left-5 font-latin">{label}</span>

  <!-- 手绘细线框 -->
  <span class="cover-frame absolute inset-2.5"></span>
</div>

<style>
  .cover-wash {
    background: linear-gradient(
      142deg,
      var(--cover-deep) 0%,
      var(--cover-light) 55%,
      var(--cover-light) 100%
    );
  }

  .cover-dots {
    background-image: radial-gradient(circle, rgb(255 255 255 / 0.9) 1px, transparent 1px);
    background-size: 13px 13px;
    opacity: 0.5;
    mask-image: linear-gradient(112deg, #000 0%, transparent 62%);
  }

  .cover-glyph {
    font-size: clamp(2.75rem, 4.4vw, 3.75rem);
    line-height: 1;
    color: rgb(255 255 255 / 0.92);
    text-shadow: 0 2px 0 color-mix(in srgb, var(--cover-accent) 28%, transparent);
    letter-spacing: 0.02em;
  }

  .cover-label {
    font-size: 0.6875rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cover-accent) 78%, #ffffff);
  }

  .cover-frame {
    border: 1px solid rgb(255 255 255 / 0.5);
    border-radius: 12px 18px 10px 16px;
    pointer-events: none;
  }

  /* 深色模式：整体压暗，只留一点点封面感 */
  :global(.dark) .cover-wash {
    opacity: 0.42;
  }

  :global(.dark) .cover-dots {
    opacity: 0.16;
  }

  :global(.dark) .cover-glyph {
    color: rgb(255 255 255 / 0.42);
    text-shadow: none;
  }

  :global(.dark) .cover-spiral {
    color: rgb(255 255 255 / 0.16);
  }

  :global(.dark) .cover-label {
    color: rgb(255 255 255 / 0.4);
  }

  :global(.dark) .cover-frame {
    border-color: rgb(255 255 255 / 0.14);
  }
</style>
