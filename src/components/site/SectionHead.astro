---
interface Props {
  kicker?: string;
  title: string;
  href?: string;
  linkLabel?: string;
  class?: string;
}

const { kicker, title, href, linkLabel = '全部', class: cls = '' } = Astro.props;
---

<div class:list={['flex flex-wrap items-end justify-between gap-4', cls]}>
  <div>
    {kicker && <p class="kicker">{kicker}</p>}
    <h2 class:list={['font-display text-[1.75rem] leading-tight text-ink', kicker && 'mt-3']}>
      {title}
    </h2>
  </div>
  {
    href && (
      <a
        href={href}
        class="group inline-flex items-center gap-1.5 text-[0.8125rem] text-ink-soft underline decoration-sakura-ink/60 decoration-wavy decoration-[1.5px] underline-offset-[6px] transition hover:text-ink"
      >
        {linkLabel}
        <span class="transition duration-200 group-hover:translate-x-0.5">→</span>
      </a>
    )
  }
</div>
