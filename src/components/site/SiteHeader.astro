---
import StarIcon from '../ui/StarIcon.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import SearchDialog from './SearchDialog.astro';

const nav = [
  { href: '/posts', label: '文章' },
  { href: '/tags', label: '标签' },
  { href: '/games', label: '游戏' },
  { href: '/about', label: '关于' },
];

const path = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-paper/85 backdrop-blur-md">
  <div
    class="mx-auto flex h-16 max-w-[1120px] items-center justify-between gap-2 px-4 sm:gap-4 sm:px-8 lg:px-10"
  >
    <a href="/" class="group flex shrink-0 items-baseline gap-2">
      <StarIcon
        size={13}
        class="translate-y-[-2px] text-sakura-ink transition duration-300 group-hover:rotate-90"
      />
      <span class="font-latin text-[1rem] font-semibold tracking-wide text-ink sm:text-[1.0625rem]">
        Phanatomcat
      </span>
      <span class="hidden font-display text-[0.75rem] text-ink-mute sm:inline">海螺手帐</span>
    </a>

    <nav class="flex items-center gap-3 sm:gap-7" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'whitespace-nowrap text-[0.75rem] text-ink-soft transition duration-200 hover:text-ink hover:underline hover:decoration-sakura-ink hover:decoration-wavy hover:decoration-[1.5px] hover:underline-offset-[7px] sm:text-[0.875rem]',
              path.startsWith(item.href) &&
                'text-ink underline decoration-sakura-ink decoration-wavy decoration-[1.5px] underline-offset-[7px]',
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href="/rss.xml"
        class="hidden items-center gap-1.5 rounded-full border-[1.5px] border-line px-3.5 py-1.5 text-[0.8125rem] text-ink-soft transition hover:-translate-y-px hover:border-night/50 hover:text-ink md:inline-flex"
      >
        <span class="font-latin text-[0.6875rem] uppercase tracking-[0.14em]">RSS</span>
      </a>
      <SearchDialog />
      <ThemeToggle />
    </div>
  </div>
</header>
