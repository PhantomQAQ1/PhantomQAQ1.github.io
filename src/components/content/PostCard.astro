---
import CoverArt from '../ui/CoverArt.astro';
import TagPill from '../ui/TagPill.astro';
import StickerTape from '../ui/StickerTape.astro';

interface Tag {
  name: string;
  tone?: 'sakura' | 'mint' | 'night' | 'plain';
}

interface Post {
  slug: string;
  title: string;
  excerpt: string;
  date: string;
  readingTime: number;
  label: string;
  tone?: 'sakura' | 'mint' | 'night';
  tags?: Tag[];
}

interface Props {
  post: Post;
  class?: string;
}

const { post, class: cls = '' } = Astro.props;
---

<article class:list={['card-hand group relative flex flex-col overflow-hidden', cls]}>
  <!-- 整卡可点：覆盖式链接，避免 <a> 套 <a> -->
  <a
    href={`/posts/${post.slug}`}
    class="absolute inset-0 z-10"
    aria-label={post.title}
    tabindex="-1"></a>

  <div class="relative">
    <CoverArt slug={post.slug} label={post.label} tone={post.tone} class="w-full" />
    <StickerTape class="-top-2 left-5" rotate={-7} width={74} />
  </div>

  <div class="flex flex-1 flex-col p-5">
    <div class="flex items-center gap-2 font-latin text-[0.75rem] font-medium text-ink-mute">
      <time datetime={post.date}>{post.date}</time>
      <span class="h-1 w-1 rounded-full bg-ink-mute/50"></span>
      <span>{post.readingTime} 分钟</span>
    </div>

    <h3
      class="mt-2.5 font-display text-[1.1875rem] leading-[1.5] text-ink transition duration-200 group-hover:text-night-deep"
    >
      {post.title}
    </h3>

    <p class="mt-2 line-clamp-2 text-[0.875rem] leading-[1.75] text-ink-soft">{post.excerpt}</p>

    {
      post.tags && post.tags.length > 0 && (
        <div class="relative z-20 mt-4 flex flex-wrap gap-1.5">
          {post.tags.map((tag) => (
            <TagPill name={tag.name} tone={tag.tone} />
          ))}
        </div>
      )
    }
  </div>
</article>
